{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observed COM build lanes, not authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recorded_at", "lanes"],
  "properties": {
    "version": {"const": "0.1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "lanes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lane"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["work_id", "title", "owner", "state", "mutates", "repository", "branch", "observed_head", "observed_at", "write_scope", "no_touch", "next_action", "blocker", "unblocks_when", "handback_event", "sources", "receipt"],
      "properties": {
        "work_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]*$"},
        "title": {"$ref": "#/$defs/text"},
        "owner": {"$ref": "#/$defs/text"},
        "state": {"enum": ["queued", "building", "waiting", "handback", "closed"]},
        "mutates": {"type": "boolean"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "branch": {"$ref": "#/$defs/text"},
        "observed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "write_scope": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "no_touch": {"$ref": "#/$defs/texts"},
        "next_action": {"$ref": "#/$defs/text"},
        "blocker": {"type": ["string", "null"], "minLength": 1},
        "unblocks_when": {"type": ["string", "null"], "minLength": 1},
        "handback_event": {"$ref": "#/$defs/text"},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "receipt": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
