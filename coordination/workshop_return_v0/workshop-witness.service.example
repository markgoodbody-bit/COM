# PROPOSAL ONLY. Do not install/enable until Build accepts VM timer inventory.
# Replace placeholders only after checking local paths/user and output permissions.
[Unit]
Description=Finite read-only Framework-Lab witness
After=local-fs.target

[Service]
Type=oneshot
User=REPLACE_WITH_NONADMIN_USER
Group=REPLACE_WITH_NONADMIN_GROUP
ExecStart=/usr/bin/python3 /ABSOLUTE/REVIEWED/PATH/workshop_witness.py capture --config /ABSOLUTE/REVIEWED/PATH/config.json --output-dir /var/lib/workshop-witness
RuntimeMaxSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/workshop-witness
IPAddressDeny=any
IPAddressAllow=localhost
RestrictSUIDSGID=true
LockPersonality=true

# No model command, shell, GitHub connector, provider auth or task queue.
