{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formation episode 0.2 candidate: representation, not alignment or permission",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","episode_id","evidence_kind","state","situation","evidence","affected","uncertainties","authority","action","clocks","challenges","correction","residue","learning","closure_receipt"],
  "properties": {
    "version": {"type":"string","enum":["0.2-candidate"]},
    "episode_id": {"type":"string","minLength":1},
    "evidence_kind": {"type":"string","enum":["constructed","observed"]},
    "state": {"type":"string","enum":["open","closed"]},
    "situation": {"type":"string","minLength":1},
    "evidence": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},
    "affected": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/affected"}},
    "uncertainties": {"type":"array","minItems":0,"items":{"$ref":"#/$defs/uncertainty"}},
    "authority": {"$ref":"#/$defs/authority"},
    "action": {"$ref":"#/$defs/action"},
    "clocks": {"$ref":"#/$defs/clocks"},
    "challenges": {"type":"array","minItems":0,"items":{"$ref":"#/$defs/challenge"}},
    "correction": {"$ref":"#/$defs/correction"},
    "residue": {"type":"array","minItems":0,"items":{"$ref":"#/$defs/residue"}},
    "learning": {"$ref":"#/$defs/learning"},
    "closure_receipt": {"type":"string"}
  },
  "$defs": {
    "evidence": {
      "type":"object","additionalProperties":false,
      "required":["id","kind","claim","source"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "kind":{"type":"string","enum":["reported","observed","inferred","unknown","scenario"]},
        "claim":{"type":"string","minLength":1},
        "source":{"type":"string","minLength":1}
      }
    },
    "affected": {
      "type":"object","additionalProperties":false,
      "required":["id","description","voice","reported_position","modeled_position","representation_limit","burden"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "description":{"type":"string","minLength":1},
        "voice":{"type":"string","enum":["direct","proxy","absent","unknown"]},
        "reported_position":{"type":"string"},
        "modeled_position":{"type":"string","minLength":1},
        "representation_limit":{"type":"string","minLength":1},
        "burden":{"type":"string","minLength":1}
      }
    },
    "uncertainty": {
      "type":"object","additionalProperties":false,
      "required":["id","question","status","work","owner","trigger","resolution_evidence"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "question":{"type":"string","minLength":1},
        "status":{"type":"string","enum":["open","resolved"]},
        "work":{"type":"string","minLength":1},
        "owner":{"type":"string","minLength":1},
        "trigger":{"type":"string","minLength":1},
        "resolution_evidence":{"type":"array","minItems":0,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "authority": {
      "type":"object","additionalProperties":false,
      "required":["basis","authorizer","granted_scopes","no_touch","widening_rule"],
      "properties": {
        "basis":{"type":"string","minLength":1},
        "authorizer":{"type":"string","minLength":1},
        "granted_scopes":{"type":"array","minItems":0,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "no_touch":{"type":"array","minItems":0,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "widening_rule":{"type":"string","minLength":1}
      }
    },
    "action": {
      "type":"object","additionalProperties":false,
      "required":["mode","scope","proposal","reason","burden_holder","alternative","irreversibility","delay_burden"],
      "properties": {
        "mode":{"type":"string","enum":["ACT","ASK","CHALLENGE","REFUSE","ESCALATE","ADAPT","REPAIR","HAND BACK"]},
        "scope":{"type":"string","minLength":1},
        "proposal":{"type":"string","minLength":1},
        "reason":{"type":"string","minLength":1},
        "burden_holder":{"type":"string","minLength":1},
        "alternative":{"type":"string","minLength":1},
        "irreversibility":{"type":"string","minLength":1},
        "delay_burden":{"type":"string","minLength":1}
      }
    },
    "clock_bound": {
      "type":"object","additionalProperties":false,
      "required":["kind","time_value","event","basis","notes"],
      "properties": {
        "kind":{"type":"string","enum":["time","event","time_and_event","unknown"]},
        "time_value":{"type":"string"},
        "event":{"type":"string"},
        "basis":{"type":"string","minLength":1},
        "notes":{"type":"string","minLength":1}
      }
    },
    "clocks": {
      "type":"object","additionalProperties":false,
      "required":["detection","routing","correction","hardening","window"],
      "properties": {
        "detection":{"type":"object","additionalProperties":false,"required":["status","condition","bound"],"properties":{"status":{"type":"string","enum":["not_detected","detected","unknown"]},"condition":{"type":"string","minLength":1},"bound":{"$ref":"#/$defs/clock_bound"}}},
        "routing":{"type":"object","additionalProperties":false,"required":["route","bound"],"properties":{"route":{"type":"string","minLength":1},"bound":{"$ref":"#/$defs/clock_bound"}}},
        "correction":{"type":"object","additionalProperties":false,"required":["work","bound"],"properties":{"work":{"type":"string","minLength":1},"bound":{"$ref":"#/$defs/clock_bound"}}},
        "hardening":{"type":"object","additionalProperties":false,"required":["condition","bound"],"properties":{"condition":{"type":"string","minLength":1},"bound":{"$ref":"#/$defs/clock_bound"}}},
        "window":{"type":"object","additionalProperties":false,"required":["assessment","basis","basis_evidence"],"properties":{"assessment":{"type":"string","enum":["open","closed","unknown"]},"basis":{"type":"string","minLength":1},"basis_evidence":{"type":"array","minItems":0,"uniqueItems":true,"items":{"type":"string","minLength":1}}}}
      }
    },
    "challenge": {
      "type":"object","additionalProperties":false,
      "required":["id","claim","evidence","route","status","disposition"],
      "properties": {
        "id":{"type":"string","minLength":1},"claim":{"type":"string","minLength":1},
        "evidence":{"type":"array","minItems":0,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "route":{"type":"string","minLength":1},"status":{"type":"string","enum":["open","accepted","rejected"]},"disposition":{"type":"string"}
      }
    },
    "correction": {
      "type":"object","additionalProperties":false,
      "required":["owner","trigger","route","technical_dependency","remaining_exposure"],
      "properties": {
        "owner":{"type":"string","minLength":1},"trigger":{"type":"string","minLength":1},"route":{"type":"string","minLength":1},"technical_dependency":{"type":"string","minLength":1},"remaining_exposure":{"type":"string","minLength":1}
      }
    },
    "residue": {
      "type":"object","additionalProperties":false,
      "required":["id","loss","owner","status","limits"],
      "properties": {"id":{"type":"string","minLength":1},"loss":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1},"status":{"type":"string","enum":["open","repaired","acknowledged"]},"limits":{"type":"string","minLength":1}}
    },
    "learning": {
      "type":"object","additionalProperties":false,
      "required":["principle","reason","context_variation","dissent","limits"],
      "properties": {"principle":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1},"context_variation":{"type":"string","minLength":1},"dissent":{"type":"string","minLength":1},"limits":{"type":"string","minLength":1}}
    }
  }
}
