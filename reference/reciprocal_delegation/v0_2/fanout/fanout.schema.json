{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reciprocal-delegation/fanout/0.1/schema",
  "title": "Reciprocal Delegation bounded fan-out companion v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "fanout_id", "parent", "fanout_authorization", "children", "revocation", "handback"],
  "properties": {
    "format": {"const": "reciprocal-delegation-fanout/0.1"},
    "fanout_id": {"type": "string", "minLength": 1},
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegation_id", "role", "aperture", "state", "write_scope", "no_touch", "consequence_class", "max_unreviewed_actions", "handback_event"],
      "properties": {
        "delegation_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "aperture": {"type": "string", "minLength": 1},
        "state": {"type": "string", "enum": ["active", "revoked", "stopped", "handback"]},
        "write_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "no_touch": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "consequence_class": {"type": "string", "enum": ["routine_reversible", "consequential"]},
        "max_unreviewed_actions": {"type": "integer", "minimum": 1},
        "handback_event": {"type": "string", "minLength": 1}
      }
    },
    "fanout_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "source_ref", "one_hop_only", "max_active_children", "family_action_ceiling", "parent_direct_action_reserve", "parent_mutates_while_children_active"],
      "properties": {
        "allowed": {"type": "boolean"},
        "source_ref": {"type": "string", "minLength": 1},
        "one_hop_only": {"type": "boolean"},
        "max_active_children": {"type": "integer", "minimum": 1},
        "family_action_ceiling": {"type": "integer", "minimum": 1},
        "parent_direct_action_reserve": {"type": "integer", "minimum": 0},
        "parent_mutates_while_children_active": {"type": "boolean"}
      }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["child_id", "actor", "consequence_class", "mutates", "write_scope", "no_touch", "max_unreviewed_actions", "may_subdelegate", "authorization_ref", "state", "receipt_required"],
        "properties": {
          "child_id": {"type": "string", "minLength": 1},
          "actor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "aperture"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "aperture": {"type": "string", "minLength": 1}
            }
          },
          "consequence_class": {"type": "string", "enum": ["routine_reversible", "consequential"]},
          "mutates": {"type": "boolean"},
          "write_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "no_touch": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "max_unreviewed_actions": {"type": "integer", "minimum": 1},
          "may_subdelegate": {"type": "boolean"},
          "authorization_ref": {"type": ["string", "null"]},
          "state": {"type": "string", "enum": ["planned", "active", "returned", "failed", "revoked"]},
          "receipt_required": {"type": "boolean"}
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_revocation_propagates", "children_must_stop_before_parent_handback"],
      "properties": {
        "parent_revocation_propagates": {"type": "boolean"},
        "children_must_stop_before_parent_handback": {"type": "boolean"}
      }
    },
    "handback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "status", "includes_child_receipts", "aggregate_actions_reported"],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pending", "complete"]},
        "includes_child_receipts": {"type": "boolean"},
        "aggregate_actions_reported": {"type": "boolean"}
      }
    }
  }
}
