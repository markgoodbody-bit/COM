# Keep small transferable machine files byte-stable on Windows checkouts.
public/*.txt text eol=lf
public/*.json text eol=lf
public/*.xml text eol=lf
# Hash-pinned reading inputs also need stable checkout endings on Windows.
public/discussion/* text eol=lf
public/changes.* text eol=lf
# The stylesheet is copied verbatim; builds must not depend on checkout settings.
app/*.css text eol=lf
public/art/*.jpg -text
public/favicon.svg text eol=lf
public/favicon.ico -text
public/explore/** -text
public/resources/** -text
scripts/RESOURCE_COPIES.json -text
# Exact reviewed copies; preserve their recorded bytes on every checkout.
public/works/** -text
public/art/** -text
# Retain the existing Homer's record checkout policy; it is not a new copy.
public/art/camp-fire-responsive.json text
scripts/WORKS_COPIES.json -text
