{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markgoodbody-bit.github.io/COM/voluntary_help/schema.json",
  "title": "Help Exchange v0.1 (SHAPE ONLY)",
  "description": "Shape only, for editors and tooling. NOT the authority. The load-bearing rules are cross-field and cannot be expressed here: an accept must come from the party that did not make the standing proposal; the helped party's arbiter must not be the helper; a basis must not record nothing happening; an EMERGENCY_ACTION may never enter a consent state. Where this file and help_exchange.py disagree, the validator is right.",
  "type": "object",
  "required": [
    "schema_version",
    "exchange_id",
    "kind",
    "parties",
    "capability",
    "evidence",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "exchange_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "OFFER",
        "REQUEST",
        "EMERGENCY_ACTION"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "parties": {
      "type": "object",
      "required": [
        "initiator",
        "counterparty"
      ],
      "additionalProperties": false,
      "properties": {
        "initiator": {
          "$ref": "#/$defs/party"
        },
        "counterparty": {
          "$ref": "#/$defs/party"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "unknown"
      ],
      "properties": {
        "known": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mandate": {
      "$ref": "#/$defs/mandate"
    },
    "exit": {
      "$ref": "#/$defs/exit"
    },
    "answer_back": {
      "$ref": "#/$defs/answer_back"
    },
    "emergency": {
      "$ref": "#/$defs/emergency"
    },
    "completion": {
      "type": "object",
      "required": [
        "not_restored"
      ],
      "properties": {
        "not_restored": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": [
        "id",
        "role",
        "standing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "HELPER",
            "HELPED"
          ]
        },
        "standing": {
          "enum": [
            "SELF",
            "PROXY",
            "COLLECTIVE"
          ]
        },
        "standing_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "claims_personhood": {
          "const": false,
          "description": "this object does not adjudicate personhood"
        }
      }
    },
    "mandate": {
      "type": "object",
      "required": [
        "scope",
        "excluded"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "at least one thing this help does NOT cover"
        },
        "expires_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_at_utc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "exit": {
      "type": "object",
      "required": [
        "refusal_path",
        "withdrawal_path",
        "refusal_consequence",
        "refusal_requires_counterparty_agreement",
        "withdrawal_requires_counterparty_agreement"
      ],
      "properties": {
        "refusal_path": {
          "type": "string",
          "minLength": 1
        },
        "withdrawal_path": {
          "type": "string",
          "minLength": 1
        },
        "refusal_consequence": {
          "type": "string",
          "minLength": 1
        },
        "refusal_requires_counterparty_agreement": {
          "const": false
        },
        "withdrawal_requires_counterparty_agreement": {
          "const": false
        }
      }
    },
    "answer_back": {
      "type": "object",
      "required": [
        "helper_route",
        "helped_route",
        "helped_route_arbiter"
      ],
      "properties": {
        "helper_route": {
          "type": "string",
          "minLength": 1
        },
        "helped_route": {
          "type": "string",
          "minLength": 1
        },
        "helped_route_arbiter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "emergency": {
      "type": "object",
      "required": [
        "authority_basis",
        "necessity_basis",
        "residue",
        "voluntary"
      ],
      "properties": {
        "authority_basis": {
          "type": "string",
          "minLength": 1
        },
        "necessity_basis": {
          "type": "string",
          "minLength": 1
        },
        "residue": {
          "type": "string",
          "minLength": 1
        },
        "voluntary": {
          "const": false
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "to",
        "actor",
        "at_utc",
        "basis"
      ],
      "properties": {
        "to": {
          "enum": [
            "ACCEPTED",
            "ACTIVE",
            "COMPLETED",
            "CONSIDERING",
            "COUNTERED",
            "DISPUTED",
            "NOTIFIED",
            "OFFERED",
            "PAUSED",
            "REFUSED",
            "REVIEWED",
            "TAKEN",
            "WITHDRAWN"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "at_utc": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "description": "why this happened. Must not record nothing happening."
        }
      }
    }
  }
}